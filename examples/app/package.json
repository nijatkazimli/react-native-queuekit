{
  "name": "queuekit-example",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-background-task": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build:lib": "npm --prefix ../.. run build",
    "start": "npm run build:lib && expo start --dev-client",
    "ios": "npm run build:lib && expo run:ios",
    "android": "npm run build:lib && expo run:android",
    "web": "npm run build:lib && expo start --web",
    "typecheck": "tsc --noEmit",
    "ios:release": "npm run build:lib && expo run:ios --configuration Release --no-bundler",
    "e2e": "maestro test .maestro"
  },
  "private": true,
  "description": "Expo test app for @nijatk/react-native-queuekit"
}
